opam-version: "2.0"
synopsis: "Lwt + cohttp backend for ocaml-gcloud"
description:
  "Credential discovery, HTTP client and Lwt instantiations of every gcloud service module."
maintainer: ["Imandra <tech@imandra.ai>"]
authors: ["Matt Bray <matt@imandra.ai>" "Dave Aitken <dave@imandra.ai>"]
homepage: "https://github.com/imandra-ai/ocaml-gcloud"
bug-reports: "https://github.com/imandra-ai/ocaml-gcloud/issues"
depends: [
  "alcotest" {with-test}
  "alcotest-lwt" {with-test}
  "gcloud"
  "cohttp"
  "cohttp-lwt"
  "cohttp-lwt-unix"
  "containers"
  "cstruct"
  "dune" {>= "3.8"}
  "jose"
  "logs"
  "lwt"
  "ppx_here" {with-test}
  "ptime"
  "tls" {with-test}
  "uri"
  "x509" {>= "0.12.0" & < "1.0"}
  "yojson"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/imandra-ai/ocaml-gcloud.git"
