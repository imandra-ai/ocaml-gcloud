# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Direct-style (OCaml 5 effects / thread pool) backend for ocaml-gcloud"
description:
  "ezcurl HTTP client, credential discovery and direct-style instantiations of every gcloud service module, for moonpool, picos and plain threads. The optional gcloud-direct.picos sub-library adds a fiber-suspending sleep."
maintainer: ["Imandra <tech@imandra.ai>"]
authors: ["Matt Bray <matt@imandra.ai>" "Dave Aitken <dave@imandra.ai>"]
homepage: "https://github.com/imandra-ai/ocaml-gcloud"
bug-reports: "https://github.com/imandra-ai/ocaml-gcloud/issues"
depends: [
  "gcloud"
  "cohttp"
  "containers"
  "cstruct"
  "dune" {>= "3.8"}
  "ezcurl"
  "jose"
  "logs"
  "ocurl"
  "uri"
  "x509" {>= "0.12.0" & < "1.0"}
  "yojson"
  "odoc" {with-doc}
]
depopts: ["picos_std"]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/imandra-ai/ocaml-gcloud.git"
